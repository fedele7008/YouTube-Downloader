QMainWindow, QLabel, QDialog, QListWidget, QWidget {
    background-color: ${base-background-color};
    color: ${base-foreground-color};
}

QScrollBar:vertical {
    border: 1px solid transparent;
    background: transparent;
    width:10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: ${scroll-bar-color};
    min-height: 0px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical {
    background: transparent;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    height: 0px;
}

QScrollBar::sub-line:vertical {
    background: transparent;
    subcontrol-position: top;
    subcontrol-origin: margin;
    height: 0px;
}

QScrollBar:horizontal {
    border: 1px solid transparent;
    background: transparent;
    height:10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: ${scroll-bar-color};
    min-width: 0px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal {
    background: transparent;
    subcontrol-position: right;
    subcontrol-origin: margin;
    width: 0px;
}

QScrollBar::sub-line:horizontal {
    background: transparent;
    subcontrol-position: left;
    subcontrol-origin: margin;
    width: 0px;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QMenuBar {
    background: ${base-background-color};
    border: none;
    padding: 2px;
    border-bottom: 1px solid ${border-color};
    font-size: ${font-size:-2}px;
    spacing: 0px;
}

QMenuBar::item {
    border: none;
    padding: 4px 8px 4px 8px;
    color: ${base-foreground-color};
}

QMenuBar::item:selected {
    background: ${secondary-color};
    color: ${secondary-text-color};
}

QMenuBar::item:pressed {
    border: none;
    background: ${secondary-pressed-color};
    color: ${secondary-text-color};
}

QMenu {
    background-color: ${field-background-color};
    color: ${base-foreground-color};
    margin: 0px;
}

QMenu::item {
    padding: 2px 25px 2px 10px;
    border: 1px solid transparent;
    font-size: ${font-size:-2}px;
}

QMenu::item:selected {
    border-color: ${border-color};
    background: ${secondary-color};
    color: ${secondary-text-color};
}

QLineEdit {
    background-color: ${field-background-color};
    color: ${base-foreground-color};
}

QPushButton {
    padding: 5px;
    border: none;
    border-radius: 4px;
    color: ${base-foreground-color};
}

QComboBox
{
    background-color: ${field-background-color};
    color: ${base-foreground-color};
    border: 1px solid transparent;
    border-radius: 4px;
    padding-left: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
}

QComboBox:on {
    color: grey;
    background-color: ${border-color};
}

QComboBox:hover {
    border-color: ${border-color};
}

QComboBox QAbstractItemView {
    background-color: ${base-background-color};
    color: ${base-foreground-color};
    border: none;
    padding: 5px;
    outline: none;
}

QListWidget {
    border: none;
}

QListView {
    outline: none;
}

QListWidget::item {
    background: ${base-background-color};
    color: ${base-foreground-color};
    padding: 8px;
    padding-left: 15px;
}

QListWidget::item:hover {
    background: ${background-hover-color};
}

QListWidget::item:selected {
    background: ${secondary-color};
    color: ${secondary-text-color};
    border: none;
    outline: none;
}

QScrollArea {
    border: none;
}

QCheckBox::indicator {
    border: 2px solid ${border-color};
    border-radius: 4px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid ${border-color};
}

QCheckBox::indicator:unchecked:hover {
    border: 2px solid ${secondary-hover-color};
}

QCheckBox::indicator:unchecked:pressed {
    border: 2px solid ${secondary-pressed-color};
}

QCheckBox::indicator:checked {
    border: 2px solid ${secondary-color};
    background: ${secondary-hover-color};
}

QCheckBox::indicator:checked:hover {
    background: ${secondary-pressed-color};
}

QCheckBox::indicator:checked:pressed {
    background: ${secondary-pressed-color};
}

QTextEdit[class="readonly"] {
    background-color: ${base-background-color};
    color: ${base-foreground-color};
    padding: 2px;
    margin: 10px;
    margin-left: 3px;
    border: 1px solid ${border-color};
    border-radius: 4px;
}

QPushButton[class="primary"] {
    border: 1px solid transparent;
    background-color: ${primary-color};
    color: ${primary-text-color};
}

QPushButton[class="primary"]:hover {
    background-color: ${primary-hover-color};
}

QPushButton[class="primary"]:pressed {
    background-color: ${primary-pressed-color};
}

QPushButton[class="primary"]:disabled {
    background-color: ${disabled-color};
}

QPushButton[class="secondary"] {
    border: 1px solid transparent;
    background-color: ${secondary-color};
    color: ${secondary-text-color};
}

QPushButton[class="secondary"]:hover {
    background-color: ${secondary-hover-color};
}

QPushButton[class="secondary"]:pressed {
    background-color: ${secondary-pressed-color};
}

QPushButton[class="secondary"]:disabled {
    background-color: ${disabled-color};
}

QPushButton[class="accent"] {
    border: 1px solid transparent;
    background-color: ${accent-color};
    color: ${accent-text-color};
}

QPushButton[class="accent"]:hover {
    background-color: ${accent-hover-color};
}

QPushButton[class="accent"]:pressed {
    background-color: ${accent-pressed-color};
}

QPushButton[class="accent"]:disabled {
    background-color: ${disabled-color};
}

QPushButton[class="neutral"] {
    border: 1px solid transparent;
    background-color: ${neutral-color};
    color: ${neutral-text-color};
}

QPushButton[class="neutral"]:hover {
    background-color: ${neutral-hover-color};
}

QPushButton[class="neutral"]:pressed {
    background-color: ${neutral-pressed-color};
}

QPushButton[class="neutral"]:disabled {
    background-color: ${disabled-color};
}

QPushButton[class="primary-hollow"] {
    background-color: transparent;
    border: 1px solid ${primary-color};
    color: ${base-foreground-color};
}

QPushButton[class="primary-hollow"]:hover {
    border-color: ${primary-hover-color};
}

QPushButton[class="primary-hollow"]:pressed {
    border-color: ${primary-pressed-color};
}

QPushButton[class="primary-hollow"]:disabled {
    border-color: ${disabled-color};
}

QPushButton[class="secondary-hollow"] {
    background-color: transparent;
    border: 1px solid ${secondary-color};
    color: ${base-foreground-color};
}

QPushButton[class="secondary-hollow"]:hover {
    border-color: ${secondary-hover-color};
}

QPushButton[class="secondary-hollow"]:pressed {
    border-color: ${secondary-pressed-color};
}

QPushButton[class="secondary-hollow"]:disabled {
    border-color: ${disabled-color};
}

QPushButton[class="accent-hollow"] {
    background-color: transparent;
    border: 1px solid ${accent-color};
    color: ${base-foreground-color};
}

QPushButton[class="accent-hollow"]:hover {
    border-color: ${accent-hover-color};
}

QPushButton[class="accent-hollow"]:pressed {
    border-color: ${accent-pressed-color};
}

QPushButton[class="accent-hollow"]:disabled {
    border-color: ${disabled-color};
}

QPushButton[class="neutral-hollow"] {
    background-color: transparent;
    border: 1px solid ${neutral-color};
    color: ${base-foreground-color};
}

QPushButton[class="neutral-hollow"]:hover {
    border-color: ${neutral-hover-color};
}

QPushButton[class="neutral-hollow"]:pressed {
    border-color: ${neutral-pressed-color};
}

QPushButton[class="neutral-hollow"]:disabled {
    border-color: ${disabled-color};
}

QLabel[class="input-label"] {
    padding: 3px;
    padding-right: 0px;
}

QLineEdit[class="input-field"] {
    padding: 2px;
}

QWidget[class="settings-content"] {
    border: none;
}

QLabel[class="settings-section-title"] {
    font-size: ${font-size:+4}px;
}

QFrame#hline {
    background-color: ${border-color};
}

#content-widget {
    margin: 0px;
}

#setup-welcome-label {
    font-size: ${font-size:+12}px;
}

#setup-config-language-label { 
    min-width: 120px;
}

#setup-config-language-selector { }

#setup-config-theme-label { 
    min-width: 120px;
}

#setup-config-theme-selector { }

#setup-start-button {
    padding-left: 20px;
    padding-right: 20px;
}

#search-pane-input-error-label {
    color: ${accent-color};
    font-size: ${font-size:-2}px;
}

#search-pane-search-button {
    padding-left: 20px;
    padding-right: 20px;
    margin-right: 0px;
}

#error-dialog {
    background-color: ${base-background-color};
    padding-left: 10px;
    padding-right: 10px;
}

#error-dialog-okay-button {
    padding-left: 15px;
    padding-right: 15px;
}

#about-dialog-app-name-label {
    font-size: ${font-size:+12}px;
}

#about-dialog-app-version-label {
    font-size: ${font-size:+4}px;
}

#about-dialog-description-label {
    margin-top: 12px;
}

#about-dialog-close-button {
    padding-left: 20px;
    padding-right: 20px;
}

#license-dialog-license-label {
    margin-top: 12px;
}

#license-dialog-close-button {
    padding-left: 20px;
    padding-right: 20px;
}

#settings-dialog-restore-button {
    padding-left: 20px;
    padding-right: 20px;
}

#settings-dialog-cancel-button {
    padding-left: 20px;
    padding-right: 20px;
}

#settings-dialog-apply-button {
    padding-left: 20px;
    padding-right: 20px;
}

#settings-dialog-save-button {
    padding-left: 20px;
    padding-right: 20px;
}

#settings-dialog-footer-widget {
    border-top: 1px solid ${border-color};
}

#settings-dialog-settings-list {
    border-right: 1px solid ${border-color};
}

#settings-general-locale-language-input {
    max-width: 200px;
}
